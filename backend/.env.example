# ===================================================
# AI SaaS Platform — Backend Configuration
# ===================================================

# Application
PROJECT_NAME="AI SaaS Platform"
PROJECT_VERSION="1.0.0"

# JWT Secret Key (Generate a random 32-byte secret in production)
SECRET_KEY="super-secret-jwt-key-replace-with-random-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Default SQLite zero-config; or PostgreSQL: postgresql://user:pass@localhost:5432/saas_db)
DATABASE_URL="sqlite:///./saas_platform.db"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# AI Providers (Optional - Smart Mock Engine works out-of-the-box if left empty)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
